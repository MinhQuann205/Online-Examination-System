DATABASE_URL="postgresql://exam_user:change-me@localhost:5432/online_exam"
POSTGRES_DB=online_exam
POSTGRES_USER=exam_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional exact origins for Swagger mutations; comma separated, no paths/wildcards.
# CLI clients must send Origin: <WEB_ORIGIN> on POST/PUT/PATCH/DELETE.
CSRF_TRUSTED_ORIGINS=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

